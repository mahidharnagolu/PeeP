<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base App Theme — Always Dark -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/surface_border</item>
        <item name="colorOnSurfaceVariant">@color/secondary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorOnBackground">@color/white</item>

        <!-- Status bar & nav bar -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Dialog theming -->
        <item name="alertDialogTheme">@style/PeepAlertDialog</item>
        <item name="android:alertDialogTheme">@style/PeepAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/PeepMaterialAlertDialog</item>
    </style>

    <!-- Themed AlertDialog (system-style) -->
    <style name="PeepAlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/PeepDialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/PeepDialogNegativeButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/PeepDialogNegativeButton</item>
    </style>

    <!-- Material AlertDialog (Compose / Material Components) -->
    <style name="PeepMaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="buttonBarPositiveButtonStyle">@style/PeepDialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/PeepDialogNegativeButton</item>
    </style>

    <!-- Dialog positive button style -->
    <style name="PeepDialogPositiveButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dialog negative button style -->
    <style name="PeepDialogNegativeButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/secondary</item>
    </style>

</resources>
